<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="E2S.NginxPanel.Sections.Top.Component.ServerControl"
             x:Name="SControl"
             xmlns:Res="clr-namespace:E2S.NginxPanel.Resources.Components.ServerControl">



    <ContentView.Resources>
        <Res:MyRes></Res:MyRes>
    </ContentView.Resources>


    <Border >
        <HorizontalStackLayout x:Name="ServerControlContainer">
            <Border>
                <HorizontalStackLayout>
                    <Button x:Name="Start" />
                    <Button x:Name="Refresh"></Button>
                </HorizontalStackLayout>
            </Border>
            <Button x:Name="Stop"></Button>
        </HorizontalStackLayout>
    </Border>

</ContentView>
